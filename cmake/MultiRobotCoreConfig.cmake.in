@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET Eigen3::Eigen)
  find_package(Eigen3 3.4 QUIET NO_MODULE)
endif()
if(NOT TARGET Eigen3::Eigen)
  set_and_check(_mrc_bundled_eigen "@PACKAGE_MRC_BUNDLED_EIGEN_INCLUDEDIR@")
  add_library(Eigen3::Eigen INTERFACE IMPORTED)
  set_target_properties(Eigen3::Eigen PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_mrc_bundled_eigen}")
endif()

find_dependency(nlohmann_json 3.11)

include("${CMAKE_CURRENT_LIST_DIR}/MultiRobotCoreTargets.cmake")

check_required_components(MultiRobotCore)
